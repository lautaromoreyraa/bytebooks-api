# Configuracion de MySQL para los tests, en reemplazo de la que trae
# Testcontainers 1.21: esa fija innodb_log_file_size, que MySQL 9.7 ya no
# acepta, y el servidor aborta antes de abrir el puerto. Esta replica lo que
# importa de produccion: UTC y utf8mb4.
[mysqld]
default-time-zone = +00:00
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
skip-name-resolve
